APP_ENV=development
HTTP_ADDR=:8080

# Compatibility runtime host ports. The Compose project name intentionally remains
# `flashx` for existing local volume compatibility until the V1 retirement migration.
API_PORT=8080
ADMIN_PORT=3000
POSTGRES_PORT=55432
REDIS_PORT=6379

PERSISTENCE=postgres
# Legacy V1 database credentials are intentionally retained during compatibility migration.
DATABASE_URL=postgres://flashx:flashx@localhost:55432/flashx?sslmode=disable
DATABASE_NAME=
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
JWT_SECRET=dev-change-me-please
ALLOW_DEV_IDENTITY=true

# Bootstrap one account for the OpenRide Operator portal.
ADMIN_PHONE=+84900000000
ADMIN_EMAIL=admin@openride.local
ADMIN_DISPLAY_NAME=OpenRide Operator

# Routing/maps. Development may use mock; production must use a configured provider.
# Provider billing/credentials belong to the operator deployment.
MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# SMS OTP. Development exposes debug_code; production must use a real provider.
# `webhook` expects a provider adapter accepting POST {phone, code, message}
# with Authorization: Bearer <SMS_API_KEY>.
SMS_PROVIDER=development
SMS_WEBHOOK_URL=
SMS_API_KEY=

# Payments. `cash` remains a compatibility/MVP payment method. Online gateway
# credentials are operator-owned and should be wired through provider adapters.
PAYMENT_PROVIDER=cash
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Object storage / KYC media. The OpenRide compatibility API never proxies file bytes.
# Flow: client asks API for a presigned URL -> client uploads directly to S3-compatible storage.
OBJECT_STORAGE_PROVIDER=disabled
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=600

# Push notifications. Production credentials are operator-owned.
PUSH_PROVIDER=development
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# Compatibility API -> extracted Marketplace Service.
# Leave the URL blank when running only the legacy V1 stack.
# When Marketplace is enabled, set the SAME high-entropy gateway token on both
# Edge and Marketplace. Marketplace runtime refuses to start with a token shorter
# than 24 characters, and public V2 requests without this internal token are rejected.
MARKETPLACE_SERVICE_URL=http://127.0.0.1:8090
MARKETPLACE_GATEWAY_TOKEN=dev-marketplace-gateway-token-change-me

# Next.js Operator server proxy. OPENRIDE_API_BASE_URL is canonical.
# FLASHX_API_BASE_URL remains a temporary fallback for older deployments.
OPENRIDE_API_BASE_URL=http://127.0.0.1:8080
FLASHX_API_BASE_URL=
NEXT_PUBLIC_ADMIN_PHONE=+84900000000
