APP_ENV=development
HTTP_ADDR=:8080

# Local Docker host ports. Compose project name is fixed to `flashx` in docker-compose.yml.
API_PORT=8080
ADMIN_PORT=3000
POSTGRES_PORT=55432
REDIS_PORT=6379

PERSISTENCE=postgres
DATABASE_URL=postgres://flashx:flashx@localhost:55432/flashx?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
JWT_SECRET=dev-change-me-please
ALLOW_DEV_IDENTITY=true

# Bootstrap one admin account for the Operations portal.
ADMIN_PHONE=+84900000000
ADMIN_EMAIL=admin@flashx.local
ADMIN_DISPLAY_NAME=FlashX Admin

# Routing/maps. Development may use mock; production must use a configured provider.
# Google/Mapbox/HERE usage is paid directly by the customer.
MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# SMS OTP. Development exposes debug_code; production must use a real provider.
# `webhook` expects a customer/provider adapter accepting POST {phone, code, message}
# with Authorization: Bearer <SMS_API_KEY>.
SMS_PROVIDER=development
SMS_WEBHOOK_URL=
SMS_API_KEY=

# Payments. `cash` remains a valid MVP payment method. Online gateway credentials
# are customer-owned and will be wired through the provider adapter.
PAYMENT_PROVIDER=cash
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Object storage / KYC media. The FlashX API NEVER receives file bytes.
# Flow: client asks API for a presigned URL -> client PUTs directly to S3-compatible storage.
# VNDATA example endpoint: https://s3-hcm-r2.s3cloud.vn
OBJECT_STORAGE_PROVIDER=disabled
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=600

# Push notifications. Production credentials are customer-owned.
PUSH_PROVIDER=development
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# Next.js Admin server proxy.
FLASHX_API_BASE_URL=http://127.0.0.1:8080
NEXT_PUBLIC_ADMIN_PHONE=+84900000000
