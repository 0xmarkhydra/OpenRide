FROM golang:1.25-alpine AS build

WORKDIR /src
COPY services/api/go.mod services/api/go.sum ./
RUN go mod download
COPY services/api/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/openride-compat-api ./cmd/api

FROM alpine:3.22 AS runtime
RUN apk add --no-cache ca-certificates postgresql-client \
    && addgroup -S openride \
    && adduser -S -G openride -u 10001 openride

WORKDIR /app
COPY --from=build /out/openride-compat-api /app/openride-compat-api
COPY infrastructure/migrations /app/migrations
COPY scripts/railway_migrate.sh /app/railway_migrate.sh
RUN chmod 0755 /app/railway_migrate.sh \
    && chown -R openride:openride /app

USER openride
EXPOSE 8080
ENTRYPOINT ["/app/openride-compat-api"]
