{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openride.dev/contracts/marketplace-event.v1.schema.json",
  "title": "OpenRide Marketplace Event Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "occurred_at", "payload"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._][a-z0-9]+)*\\.v[1-9][0-9]*$",
      "examples": ["marketplace.offers_ready.v1", "ride.status_changed.v1"]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string"
    },
    "causation_id": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
